        if (squeek_.code.length == 0) revert InvalidContract(squeek_);
        if (vault_.code.length == 0) revert InvalidContract(vault_);
        if (initialFeeBps > MAX_FEE_BPS) revert FeeTooHigh(initialFeeBps);
        if (auctionDuration_ == 0) revert InvalidAuctionDuration();
        sqk = BurrowMarketIERC20(sqk_);
        squeek = BurrowMarketIERC721(squeek_);
        vault = IBurrowMarketVault(vault_);
        auctionDuration = auctionDuration_;
        feeBps = initialFeeBps;
        emit FeeBpsUpdated(0, initialFeeBps);
    }

    /// @notice Escrow an NFT at a fixed SQK price. Approve this market before calling.
    function list(uint256 tokenId, uint256 price) external nonReentrant {
        if (price == 0) revert InvalidPrice();
        _checkCanList(tokenId);
        listings[tokenId] = Listing(msg.sender, price, price, block.timestamp, feeBps, false);
        emit Listed(tokenId, msg.sender, price, feeBps);
        squeek.safeTransferFrom(msg.sender, address(this), tokenId);
    }

    /// @notice Escrow an NFT for a Dutch auction, including NFTs obtained in liquidation.
    /// @dev The seller chooses a premium startPrice strictly above a nonzero floorPrice.
    /// The duration is fixed for this market. An unsold NFT remains purchasable at the
    /// floor after that window, and only its seller may cancel it.
    function startAuction(uint256 tokenId, uint256 startPrice, uint256 floorPrice) external nonReentrant {
        if (floorPrice == 0 || startPrice <= floorPrice) revert InvalidAuctionPrices(startPrice, floorPrice);
        _checkCanList(tokenId);
        listings[tokenId] = Listing(msg.sender, startPrice, floorPrice, block.timestamp, feeBps, true);
        emit AuctionStarted(tokenId, msg.sender, startPrice, floorPrice, block.timestamp, auctionDuration, feeBps);
        squeek.safeTransferFrom(msg.sender, address(this), tokenId);
    }

    /// @notice Cancel either type of sale and return the escrowed NFT to its seller.
    function cancel(uint256 tokenId) external nonReentrant {
        address seller = listings[tokenId].seller;
        if (seller == address(0)) revert NotListed(tokenId);
        if (seller != msg.sender) revert NotSeller(tokenId);
        delete listings[tokenId];
        emit Cancelled(tokenId, seller);
        squeek.safeTransferFrom(address(this), seller, tokenId);
    }

    /// @notice Buy a fixed-price listing or auction for no more than maxPrice SQK.
    /// @dev There is deliberately no unbounded overload: a seller could otherwise cancel
    /// and relist at any price up to the buyer's allowance ahead of the purchase.
    function buy(uint256 tokenId, uint256 maxPrice) external nonReentrant {
        _buy(tokenId, maxPrice);
    }

    /// @notice Quote the current gross price, including the fee, for either sale type.
    function currentPrice(uint256 tokenId) external view returns (uint256) {
        Listing memory listing = listings[tokenId];
        if (listing.seller == address(0)) revert NotListed(tokenId);
        return _price(listing);
    }

    /// @notice Set the fee for future listings; existing sellers keep their agreed fee.
    function setFeeBps(uint256 newFeeBps) external onlyOwner nonReentrant {
        if (newFeeBps > MAX_FEE_BPS) revert FeeTooHigh(newFeeBps);
        uint256 oldFeeBps = feeBps;
        feeBps = newFeeBps;
        emit FeeBpsUpdated(oldFeeBps, newFeeBps);
    }

    /// @dev Accept only the safe transfer initiated by list/startAuction. This callback
    /// performs no value transfer and runs inside their nonReentrant guard. Unsolicited
    /// safe transfers are rejected; do not send NFTs here with unsafe transferFrom.
    function onERC721Received(address operator, address from, uint256 tokenId, bytes memory)
        public
        view
        override
        returns (bytes4)
    {
        if (
            msg.sender != address(squeek) || operator != address(this) || !_reentrancyGuardEntered()
                || from == address(0) || listings[tokenId].seller != from
        ) revert UnexpectedNFT();
        return BurrowMarketIERC721Receiver.onERC721Received.selector;
    }

    function _checkCanList(uint256 tokenId) private view {
        if (listings[tokenId].seller != address(0)) revert AlreadyListed(tokenId);
        if (squeek.ownerOf(tokenId) != msg.sender) revert NotTokenOwner(tokenId);
    }

    function _price(Listing memory listing) private view returns (uint256) {
        if (!listing.isAuction) return listing.price;
        uint256 elapsed = block.timestamp - listing.startedAt;
        if (elapsed >= auctionDuration) return listing.floorPrice;
        // Full-precision multiplication avoids overflow even for extreme prices.
        // Round the discount down so the gross price rounds up and never undershoots.
        return listing.price - BurrowMarketMath.mulDiv(listing.price - listing.floorPrice, elapsed, auctionDuration);
    }

    function _buy(uint256 tokenId, uint256 maxPrice) private {
        Listing memory listing = listings[tokenId];
        if (listing.seller == address(0)) revert NotListed(tokenId);
        uint256 price = _price(listing);
        if (price > maxPrice) revert PriceExceedsLimit(price, maxPrice);
        uint256 fee = BurrowMarketMath.mulDiv(price, listing.saleFeeBps, BPS);

        // Consume the listing before any token, vault or recipient callback.
        delete listings[tokenId];
        emit Sold(tokenId, listing.seller, msg.sender, price, fee);

        uint256 balanceBefore = sqk.balanceOf(address(this));
        sqk.safeTransferFrom(msg.sender, address(this), price);
        uint256 balanceAfter = sqk.balanceOf(address(this));
        if (balanceAfter < balanceBefore || balanceAfter - balanceBefore != price) revert UnexpectedSQKTransfer();

        if (fee != 0) {
            // donate pulls SQK. Approve only this fee and revoke any residual allowance.
            sqk.forceApprove(address(vault), fee);
            vault.donate(fee);
            sqk.forceApprove(address(vault), 0);
            uint256 balanceAfterDonation = sqk.balanceOf(address(this));
            if (balanceAfterDonation > balanceAfter || balanceAfter - balanceAfterDonation != fee) {
                revert FeeNotCollected();
            }
        }
        sqk.safeTransfer(listing.seller, price - fee);
        squeek.safeTransferFrom(address(this), msg.sender, tokenId);
    }
}

