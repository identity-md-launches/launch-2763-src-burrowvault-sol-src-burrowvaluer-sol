// -----------------------------------------------------------------------------
// Burrow interfaces. ABI-compatible with the supplied live staking interface and
// Uniswap v4 PositionManager. No NFT metadata/level selector is assumed.
// -----------------------------------------------------------------------------

interface IBurrowValuer {
    function creditLine(uint256[] calldata tokenIds) external view returns (uint256);
    function ltvBps() external view returns (uint256);
    /// @dev Timestamp of the last EXECUTED price change; zero before the first.
    function lastPriceChange() external view returns (uint256);
}

interface IBurrowStaking {
    function deposit(address collection, uint256[] calldata tokenIds) external;
    function withdraw(address collection, uint256[] calldata tokenIds) external;
    function claim(address recipient) external;
    function setClaimRecipient(address recipient) external;
    function claimable(address account) external view returns (uint256);
    function accountPower(address account) external view returns (uint256 nftPower, uint256 sqkPower);
}

interface IBurrowPoolManager {
    function extsload(bytes32 slot) external view returns (bytes32);
}

interface IBurrowPositionManager is IERC721 {
    // Currency and IHooks are addresses in the ABI; PositionInfo is uint256.
    struct PoolKey {
        address currency0;
        address currency1;
        uint24 fee;
        int24 tickSpacing;
        address hooks;
    }
    function poolManager() external view returns (address);
    function getPoolAndPositionInfo(uint256 tokenId) external view returns (PoolKey memory, uint256);
    function getPositionLiquidity(uint256 tokenId) external view returns (uint128);
}

/// @title BurrowVault
/// @notice SQK lending, collateral rewards, protocol fee income and treasury bonds.
/// @dev Unaudited, testnet only. This is deliberately not ERC-4626: withdraw takes
/// shares and returns assets. SQK must be a non-rebasing, non-taxed 18-decimal token.
///
/// Integration contract:
/// - The immutable valuer supplies creditLine, ltvBps and lastPriceChange. Its price
///   governance must implement the two-day timelock, 20% step and immutable band.
/// - Levels are recorded as in the live NFT: 1 = 1000, 2 = 3000, 3 = 7000, etc.
///   Each individual deposit's accountPower increase gives its escrowed power.
///   accountPower returns (NFT power, SQK power), both in 18-decimal units.
/// - Only the constructor-selected v4 pool is bondable. Its SQK inventory, not the
///   paired token or uncollected fees, is valued. Inventory changes with pool price.
/// - Treasury NFTs/LPs are retained permanently and excluded from totalAssets;
///   issuing discounted bond shares therefore dilutes liquid SQK backing. All bond
///   shares enter supply at purchase, not at vesting/claim time.
/// - At most 256 simultaneous positions and 32 outstanding bonds per user bound
///   every accounting loop. A zero-debt position still owns its reward power.
/// - The first deposit locks 1000 share wei plus any pre-existing donation's shares
///   in this contract forever. Later deposits/withdrawals round down and cannot
///   reduce totalAssets / totalSupply. Use the slippage-protected overloads.
/// - The owner can pause new borrowing and adjust capped bond/bonus parameters;
///   there is no upgrade, asset rescue, arbitrary approval, or treasury withdrawal.
/// - Deploy with the Solidity optimizer enabled (for example, forge build
///   --optimize). Unoptimized bytecode exceeds EIP-170's runtime size limit.
contract BurrowVault is ERC20, ERC721Holder, ReentrancyGuard, Ownable2Step {
    using SafeERC20 for IERC20;

    uint256 public constant BPS = 10_000;
    uint256 public constant RATE_SCALE = 1e18;
    uint256 public constant MAX_RATE_PER_SECOND = uint256(0.5e18) / 365 days;
    uint256 public constant MAX_LIQUIDATION_BONUS_BPS = 1500;
    uint256 public constant MAX_BOND_DISCOUNT_BPS = 2000;
    uint256 public constant LIQUIDATION_FREEZE = 1 hours;
    uint256 public constant MAX_TOKEN_IDS = 32;
    uint256 public constant MAX_POSITIONS = 256;
    uint256 public constant MAX_BONDS = 32;
    uint256 public constant MINIMUM_LIQUIDITY = 1000;

    struct Config {
        address owner;
        address sqk;
        address squeek;
        address staking;
        address valuer;
        address positionManager;
        address poolManager;
        bytes32 bondPoolId;
        uint256 interestRatePerSecond;
        uint16 liquidationBonusBps;
        uint16 bondDiscountBps;
        uint32 bondVestingDays;
    }

    struct Position {
        uint256 principal;
        uint256 interest;
        uint256 interestRemainder;
        uint256 power;
        uint256[] tokenIds;
        uint256[] levels;
    }

    struct BondSchedule {
        uint256 shares;
        uint256 claimed;
        uint256 start;
        uint256 duration;
    }

    IERC20 public immutable sqk;
    IERC721 public immutable squeek;
    IBurrowStaking public immutable staking;
    IBurrowValuer public immutable valuer;
    IBurrowPositionManager public immutable positionManager;
    IBurrowPoolManager public immutable poolManager;
    bytes32 public immutable bondPoolId;
    uint256 public immutable interestRatePerSecond;
    uint256 public immutable bondVestingDays;

    uint256 public liquidationBonusBps;
    uint256 public bondDiscountBps;
    bool public borrowsPaused;
    uint256 public totalPrincipal;
    uint256 public totalAccruedInterest;
    uint256 public totalEscrowedPower;
    uint256 public treasuryPower;
    uint256 public lastAccrual;
    uint256 public totalSurplus;
    uint256 public unclaimedBondShares;
    uint256 public lockedShares;

    mapping(address => Position) private _positions;
    address[] private _borrowers;
    mapping(address => uint256) private _positionIndex; // index + 1
    mapping(address => BondSchedule[]) private _bonds;
    mapping(address => uint256) public surplus;
    mapping(uint256 => bool) public treasuryNFT;
    mapping(uint256 => bool) public treasuryLP;
    address private _receivingAsset;
    address private _receivingFrom;

    error InvalidContract(address account);
    error InvalidDecimals(uint8 decimals);
    error InvalidParameter();
    error RateTooHigh();
    error BonusTooHigh();
    error DiscountTooHigh();
    error ZeroAmount();
    error ZeroShares();
    error MinimumInitialDeposit(uint256 minimum);
    error Slippage(uint256 actual, uint256 minimum);
    error InsufficientLiquidity(uint256 available, uint256 requested);
    error UnexpectedTokenAmount(uint256 expected, uint256 received);
    error ReserveDeficit();
    error PositionExists();
    error PositionNotFound();
    error TooManyPositions();
    error InvalidTokenIds();
    error BorrowingPaused();
    error CreditLimitExceeded(uint256 debt, uint256 creditLine);
    error NoDebt();
    error DebtRemaining(uint256 debt);
    error HealthyPosition(uint256 debt, uint256 creditLine);
    error LiquidationFrozen(uint256 until);
    error InvalidPower(uint256 power);
    error UnexpectedNFT();
    error UnsupportedAsset(address asset);
    error WrongPool();
    error EmptyPosition();
    error VaultUnseeded();
    error TooManyBonds();
    error NothingToClaim();

    event Deposit(address indexed lender, uint256 assets, uint256 shares);
    event Withdraw(address indexed lender, uint256 shares, uint256 assets);
    event PositionOpened(address indexed borrower, uint256[] tokenIds, uint256 power);
    event PositionClosed(address indexed borrower);
    event Borrowed(address indexed borrower, uint256 amount, uint256 debt);
    event Repaid(address indexed borrower, uint256 amount, uint256 interestPaid, uint256 principalPaid);
    event InterestAccrued(uint256 interest, uint256 timestamp);
    event RewardsApplied(address indexed borrower, uint256 interestPaid, uint256 principalPaid);
    event RewardsSwept(uint256 received, uint256 debtRepaid, uint256 income);
    event Liquidated(
        address indexed borrower, address indexed liquidator, uint256 debt, uint256 payment, uint256 surplus
    );
    event SurplusClaimed(address indexed borrower, uint256 amount);
    event Donation(address indexed donor, uint256 amount);
    event BondPurchased(
        address indexed buyer, address indexed asset, uint256 indexed tokenId, uint256 value, uint256 shares
    );
    event BondClaimed(address indexed buyer, uint256 shares);
    event BorrowsPaused(bool paused);
    event LiquidationBonusUpdated(uint256 oldBps, uint256 newBps);
    event BondDiscountUpdated(uint256 oldBps, uint256 newBps);

    constructor(Config memory c) ERC20("Burrow SQK", "bSQK") Ownable(c.owner) {
        _checkContract(c.sqk);
        _checkContract(c.squeek);
        _checkContract(c.staking);
        _checkContract(c.valuer);
        _checkContract(c.positionManager);
        _checkContract(c.poolManager);
        if (c.sqk == c.squeek || c.squeek == c.positionManager || c.bondPoolId == bytes32(0) || c.bondVestingDays == 0) revert InvalidParameter();
        uint8 d = IERC20Metadata(c.sqk).decimals();
        if (d != 18) revert InvalidDecimals(d);
        if (c.interestRatePerSecond > MAX_RATE_PER_SECOND) revert RateTooHigh();
        if (c.liquidationBonusBps > MAX_LIQUIDATION_BONUS_BPS) revert BonusTooHigh();
        if (c.bondDiscountBps > MAX_BOND_DISCOUNT_BPS) revert DiscountTooHigh();
        uint256 ltv = IBurrowValuer(c.valuer).ltvBps();
        if (ltv == 0 || ltv > 6000) revert InvalidParameter();
        if (IBurrowPositionManager(c.positionManager).poolManager() != c.poolManager) revert WrongPool();
        sqk = IERC20(c.sqk);
        squeek = IERC721(c.squeek);
        staking = IBurrowStaking(c.staking);
        valuer = IBurrowValuer(c.valuer);
        positionManager = IBurrowPositionManager(c.positionManager);
        poolManager = IBurrowPoolManager(c.poolManager);
        bondPoolId = c.bondPoolId;
        interestRatePerSecond = c.interestRatePerSecond;
        liquidationBonusBps = c.liquidationBonusBps;
        bondDiscountBps = c.bondDiscountBps;
        bondVestingDays = c.bondVestingDays;
        lastAccrual = block.timestamp;
    }

    function idleAssets() public view returns (uint256) {
        uint256 balance = sqk.balanceOf(address(this));
        if (balance < totalSurplus) revert ReserveDeficit();
        return balance - totalSurplus;
    }

    /// @notice SQK available to shareholders, including earned but unpaid interest.
    /// Borrower surplus and permanently retained non-SQK treasury assets are excluded.
    function totalAssets() public view returns (uint256 assets) {
        assets = idleAssets() + totalPrincipal + totalAccruedInterest;
        uint256 elapsed = block.timestamp - lastAccrual;
        for (uint256 i; i < _borrowers.length; ++i) {
            (uint256 interest,) = _interestSince(_positions[_borrowers[i]], elapsed);
            assets += interest;
        }
    }

    function convertToShares(uint256 assets) public view returns (uint256) {
        uint256 supply = totalSupply();
        return supply == 0 ? assets : Math.mulDiv(assets, supply, totalAssets());
    }

    function convertToAssets(uint256 shares) public view returns (uint256) {
        uint256 supply = totalSupply();
        return supply == 0 ? shares : Math.mulDiv(shares, totalAssets(), supply);
    }

    function previewDeposit(uint256 assets) external view returns (uint256) {
        if (totalSupply() == 0) return assets > MINIMUM_LIQUIDITY ? assets - MINIMUM_LIQUIDITY : 0;
        return convertToShares(assets);
    }

    function debtOf(address borrower) public view returns (uint256) {
        Position storage p = _positions[borrower];
        (uint256 pending,) = _interestSince(p, block.timestamp - lastAccrual);
        return p.principal + p.interest + pending;
    }

    function creditLine(address borrower) public view returns (uint256) {
        if (_positionIndex[borrower] == 0) return 0;
        return valuer.creditLine(_positions[borrower].tokenIds);
    }

    function positionOf(address borrower) external view returns (Position memory) {
        return _positions[borrower];
    }

    function positionCount() external view returns (uint256) {
        return _borrowers.length;
    }

    function borrowerAt(uint256 index) external view returns (address) {
        return _borrowers[index];
    }

    function bondCount(address buyer) external view returns (uint256) {
        return _bonds[buyer].length;
    }

    function bondSchedule(address buyer, uint256 index) external view returns (BondSchedule memory) {
        return _bonds[buyer][index];
    }

    function deposit(uint256 assets) external nonReentrant returns (uint256 shares) {
        return _deposit(assets, 1);
    }

    function deposit(uint256 assets, uint256 minShares) external nonReentrant returns (uint256 shares) {
        return _deposit(assets, minShares);
    }

    function _deposit(uint256 assets, uint256 minShares) private returns (uint256 shares) {
        if (assets == 0) revert ZeroAmount();
        _sweepRewards();
        if (totalSupply() == 0) {
            if (assets <= MINIMUM_LIQUIDITY) revert MinimumInitialDeposit(MINIMUM_LIQUIDITY + 1);
            lockedShares = totalAssets() + MINIMUM_LIQUIDITY;
            shares = assets - MINIMUM_LIQUIDITY;
            _mint(address(this), lockedShares);
        } else {
            shares = convertToShares(assets);
        }
        if (shares == 0) revert ZeroShares();
        if (shares < minShares) revert Slippage(shares, minShares);
        _mint(msg.sender, shares);
        _pullSQK(msg.sender, assets);
        emit Deposit(msg.sender, assets, shares);
    }

    function withdraw(uint256 shares) external nonReentrant returns (uint256 assets) {
        return _withdraw(shares, 1);
    }

    function withdraw(uint256 shares, uint256 minAssets) external nonReentrant returns (uint256 assets) {
        return _withdraw(shares, minAssets);
    }

    function _withdraw(uint256 shares, uint256 minAssets) private returns (uint256 assets) {
        if (shares == 0) revert ZeroShares();
        _sweepRewards();
        assets = convertToAssets(shares);
        if (assets == 0) revert ZeroAmount();
        if (assets < minAssets) revert Slippage(assets, minAssets);
        _checkLiquidity(assets);
        _burn(msg.sender, shares);
        sqk.safeTransfer(msg.sender, assets);
        emit Withdraw(msg.sender, shares, assets);
    }

    function openPosition(uint256[] calldata tokenIds) external nonReentrant {
        _validateIds(tokenIds);
        if (_positionIndex[msg.sender] != 0) revert PositionExists();
        if (_borrowers.length == MAX_POSITIONS) revert TooManyPositions();
        _sweepRewards(); // old rewards belong to the old set of collateral
        _positionIndex[msg.sender] = _borrowers.length + 1;
        _borrowers.push(msg.sender);
        Position storage p = _positions[msg.sender];
        p.tokenIds = tokenIds;
        for (uint256 i; i < tokenIds.length; ++i) {
            _receiveNFT(squeek, msg.sender, tokenIds[i]);
            (uint256 power, uint256 level) = _stakeOne(tokenIds[i]);
            p.power += power;
            p.levels.push(level);
        }
        totalEscrowedPower += p.power;
        staking.setClaimRecipient(address(this));
        emit PositionOpened(msg.sender, tokenIds, p.power);
    }

    function borrow(uint256 amount) external nonReentrant {
        if (borrowsPaused) revert BorrowingPaused();
        if (amount == 0) revert ZeroAmount();
        _requirePosition(msg.sender);
        _sweepRewards();
        Position storage p = _positions[msg.sender];
        uint256 newDebt = p.principal + p.interest + amount;
        uint256 line = valuer.creditLine(p.tokenIds);
        if (newDebt > line) revert CreditLimitExceeded(newDebt, line);
        _checkLiquidity(amount);
        p.principal += amount;
        totalPrincipal += amount;
        sqk.safeTransfer(msg.sender, amount);
        emit Borrowed(msg.sender, amount, newDebt);
    }

    /// @notice Repay up to amount; never pulls more than the outstanding debt.
    function repay(uint256 amount) external nonReentrant returns (uint256 paid) {
        if (amount == 0) revert ZeroAmount();
        _requirePosition(msg.sender);
        if (debtOf(msg.sender) == 0) revert NoDebt();
        _sweepRewards();
        if (debtOf(msg.sender) == 0) return 0;
        return _repay(msg.sender, amount);
    }

    function repayAll() external nonReentrant returns (uint256 paid) {
        _requirePosition(msg.sender);
        _sweepRewards();
        // A sweep may have just cleared the last wei; this is a successful no-op.
        if (debtOf(msg.sender) == 0) return 0;
        return _repay(msg.sender, type(uint256).max);
    }

    function _repay(address borrower, uint256 amount) private returns (uint256 paid) {
        Position storage p = _positions[borrower];
        uint256 debt = p.principal + p.interest;
        if (debt == 0) revert NoDebt();
        paid = Math.min(amount, debt);
        (uint256 interestPaid, uint256 principalPaid) = _reduceDebt(p, paid);
        _pullSQK(msg.sender, paid);
        emit Repaid(borrower, paid, interestPaid, principalPaid);
    }

    function closePosition() external nonReentrant {
        _requirePosition(msg.sender);
        _sweepRewards();
        uint256 debt = debtOf(msg.sender);
        if (debt != 0) revert DebtRemaining(debt);
        uint256[] memory ids = _removePosition(msg.sender);
        _returnCollateral(ids, msg.sender);
        emit PositionClosed(msg.sender);
    }

    /// @notice Claims actual SQK received and apportions it by all staked NFT power.
    /// Each position pays its own accrued interest first, then principal. Treasury
    /// power, rounding dust and rewards exceeding an individual debt remain income.
    function sweepRewards() external nonReentrant returns (uint256 received, uint256 debtRepaid) {
        return _sweepRewards();
    }

    function _sweepRewards() private returns (uint256 received, uint256 debtRepaid) {
        _accrue();
        uint256 power = totalEscrowedPower + treasuryPower;
        if (power == 0) return (0, 0);
        uint256 beforeBalance = sqk.balanceOf(address(this));
        staking.claim(address(this));
        uint256 afterBalance = sqk.balanceOf(address(this));
        if (afterBalance < beforeBalance) revert UnexpectedTokenAmount(0, 0);
        received = afterBalance - beforeBalance;
        if (received == 0) return (0, 0);
        for (uint256 i; i < _borrowers.length; ++i) {
            address borrower = _borrowers[i];
            Position storage p = _positions[borrower];
            uint256 allocation = Math.mulDiv(received, p.power, power);
            uint256 payment = Math.min(allocation, p.principal + p.interest);
            if (payment != 0) {
                (uint256 interestPaid, uint256 principalPaid) = _reduceDebt(p, payment);
                debtRepaid += payment;
                emit RewardsApplied(borrower, interestPaid, principalPaid);
            }
        }
        emit RewardsSwept(received, debtRepaid, received - debtRepaid);
    }

    /// @notice Full-lot liquidation: the liquidator pays debt plus borrower equity
    /// after a bonus of debt * liquidationBonusBps / 10000. This caps the liquidator's
    /// discount even when an indivisible NFT is worth much more than the debt.
    function liquidate(address borrower) external nonReentrant returns (uint256 payment) {
        _requirePosition(borrower);
        uint256 changed = valuer.lastPriceChange();
        if (changed != 0 && (changed > block.timestamp || block.timestamp - changed < LIQUIDATION_FREEZE)) {
            revert LiquidationFrozen(changed + LIQUIDATION_FREEZE);
        }
        _sweepRewards();
        Position storage p = _positions[borrower];
        uint256 debt = p.principal + p.interest;
        uint256 line = valuer.creditLine(p.tokenIds);
        if (debt <= line) revert HealthyPosition(debt, line);
        uint256 collateralValue = _valueFromLine(line);
        uint256 bonus = Math.mulDiv(debt, liquidationBonusBps, BPS);
        payment = Math.max(debt, collateralValue > bonus ? collateralValue - bonus : 0);
        uint256 equity = payment - debt;
        surplus[borrower] += equity;
        totalSurplus += equity;
        _reduceDebt(p, debt);
        uint256[] memory ids = _removePosition(borrower);
        _pullSQK(msg.sender, payment);
        _returnCollateral(ids, msg.sender);
        emit Liquidated(borrower, msg.sender, debt, payment, equity);
    }

    function claimSurplus() external nonReentrant returns (uint256 amount) {
        amount = surplus[msg.sender];
        if (amount == 0) revert NothingToClaim();
        surplus[msg.sender] = 0;
        totalSurplus -= amount;
        sqk.safeTransfer(msg.sender, amount);
        emit SurplusClaimed(msg.sender, amount);
    }

    /// @notice The common fee sink used by BurrowMarket and BurrowHook.
    function donate(uint256 amount) external nonReentrant {
        if (amount == 0) revert ZeroAmount();
        // No loan changes here. totalAssets/debtOf include pending interest, so
        // fee routing from an afterSwap hook stays independent of borrower count.
        _pullSQK(msg.sender, amount);
        emit Donation(msg.sender, amount);
    }

    function bond(address asset, uint256 amountOrId, uint256 minShares) external nonReentrant returns (uint256 shares) {
        if (asset != address(squeek) && asset != address(positionManager)) revert UnsupportedAsset(asset);
        if (totalSupply() == 0) revert VaultUnseeded();
        if (_bonds[msg.sender].length == MAX_BONDS) revert TooManyBonds();
        _sweepRewards();
        uint256 value;
        if (asset == address(squeek)) {
            uint256[] memory ids = new uint256[](1);
            ids[0] = amountOrId;
            value = _valueFromLine(valuer.creditLine(ids));
            treasuryNFT[amountOrId] = true;
            _receiveNFT(squeek, msg.sender, amountOrId);
            (uint256 power,) = _stakeOne(amountOrId);
            treasuryPower += power;
            staking.setClaimRecipient(address(this));
        } else {
            treasuryLP[amountOrId] = true;
            _receiveNFT(IERC721(asset), msg.sender, amountOrId);
            value = positionSQKPrincipal(amountOrId);
        }
        if (value == 0) revert EmptyPosition();
        uint256 discounted = value + Math.mulDiv(value, bondDiscountBps, BPS);
        shares = convertToShares(discounted);
        if (shares == 0) revert ZeroShares();
        if (shares < minShares) revert Slippage(shares, minShares);
        _bonds[msg.sender].push(BondSchedule(shares, 0, block.timestamp, bondVestingDays * 1 days));
        unclaimedBondShares += shares;
        _mint(address(this), shares);
        emit BondPurchased(msg.sender, asset, amountOrId, value, shares);
    }

    function claimableBond(address buyer) public view returns (uint256 shares) {
        BondSchedule[] storage schedules = _bonds[buyer];
        for (uint256 i; i < schedules.length; ++i) {
            shares += _vested(schedules[i]) - schedules[i].claimed;
        }
    }

    /// @notice Releases all currently vested shares; mature schedules are removed.
    function claimBond() external nonReentrant returns (uint256 shares) {
        BondSchedule[] storage schedules = _bonds[msg.sender];
        uint256 i;
        while (i < schedules.length) {
            BondSchedule storage b = schedules[i];
            uint256 vested = _vested(b);
            shares += vested - b.claimed;
            b.claimed = vested;
            if (vested == b.shares) {
                schedules[i] = schedules[schedules.length - 1];
                schedules.pop();
            } else {
                ++i;
            }
        }
        if (shares == 0) revert NothingToClaim();
        unclaimedBondShares -= shares;
        _transfer(address(this), msg.sender, shares);
        emit BondClaimed(msg.sender, shares);
    }

    /// @notice Values only existing SQK principal in the constructor-pinned pool.
    /// No value is assigned to the other currency or to pending swap fees.
    function positionSQKPrincipal(uint256 tokenId) public view returns (uint256) {
        (IBurrowPositionManager.PoolKey memory key, uint256 info) = positionManager.getPoolAndPositionInfo(tokenId);
        if (
            keccak256(abi.encode(key)) != bondPoolId || (key.currency0 != address(sqk) && key.currency1 != address(sqk))
        ) revert WrongPool();
        uint128 liquidity = positionManager.getPositionLiquidity(tokenId);
        if (liquidity == 0) return 0;
        int24 lower = int24(uint24(info >> 8));
        int24 upper = int24(uint24(info >> 32));
        if (lower >= upper) revert WrongPool();
        uint160 sqrtA = BurrowTickMath.sqrtPriceAtTick(lower);
        uint160 sqrtB = BurrowTickMath.sqrtPriceAtTick(upper);
        // v4-core StateLibrary: PoolManager._pools is storage slot 6; slot0 is its
        // first word and contains sqrtPriceX96 in the low 160 bits.
        uint160 sqrtP = uint160(uint256(poolManager.extsload(keccak256(abi.encode(bondPoolId, uint256(6))))));
        if (sqrtP < BurrowTickMath.MIN_SQRT_PRICE || sqrtP >= BurrowTickMath.MAX_SQRT_PRICE) revert WrongPool();
        if (key.currency0 == address(sqk)) {
            if (sqrtP >= sqrtB) return 0;
            uint256 low = Math.max(sqrtP, sqrtA);
            return Math.mulDiv(uint256(liquidity) << 96, uint256(sqrtB) - low, sqrtB) / low;
        }
        if (sqrtP <= sqrtA) return 0;
        uint256 high = Math.min(sqrtP, sqrtB);
        return Math.mulDiv(liquidity, high - sqrtA, 1 << 96);
    }

    function setBorrowsPaused(bool paused) external nonReentrant onlyOwner {
        borrowsPaused = paused;
        emit BorrowsPaused(paused);
    }

    function setLiquidationBonusBps(uint256 bps) external nonReentrant onlyOwner {
        if (bps > MAX_LIQUIDATION_BONUS_BPS) revert BonusTooHigh();
        emit LiquidationBonusUpdated(liquidationBonusBps, bps);
        liquidationBonusBps = bps;
    }

    function setBondDiscountBps(uint256 bps) external nonReentrant onlyOwner {
        if (bps > MAX_BOND_DISCOUNT_BPS) revert DiscountTooHigh();
        emit BondDiscountUpdated(bondDiscountBps, bps);
        bondDiscountBps = bps;
    }

    // ERC20 movements use the same lock as the lending and treasury entrypoints.
    function transfer(address to, uint256 value) public override nonReentrant returns (bool) {
        return super.transfer(to, value);
    }

    function transferFrom(address from, address to, uint256 value) public override nonReentrant returns (bool) {
        return super.transferFrom(from, to, value);
    }

    /// @dev This receiver MUST be callable during guarded NFT transfers. It moves
    /// no value and accepts callbacks only for an explicitly initiated receipt.
    function onERC721Received(address, address from, uint256, bytes memory) public view override returns (bytes4) {
        if (msg.sender != _receivingAsset || from != _receivingFrom) revert UnexpectedNFT();
        return IERC721Receiver.onERC721Received.selector;
    }

    function _checkContract(address account) private view {
        if (account.code.length == 0) revert InvalidContract(account);
    }

    function _validateIds(uint256[] calldata ids) private pure {
        if (ids.length == 0 || ids.length > MAX_TOKEN_IDS) revert InvalidTokenIds();
        for (uint256 i = 1; i < ids.length; ++i) {
            if (ids[i] <= ids[i - 1]) revert InvalidTokenIds();
        }
    }

    function _requirePosition(address borrower) private view {
        if (_positionIndex[borrower] == 0) revert PositionNotFound();
    }

    function _checkLiquidity(uint256 amount) private view {
        uint256 available = idleAssets();
        if (available < amount) revert InsufficientLiquidity(available, amount);
    }

    function _pullSQK(address from, uint256 amount) private {
        uint256 beforeBalance = sqk.balanceOf(address(this));
        sqk.safeTransferFrom(from, address(this), amount);
        uint256 afterBalance = sqk.balanceOf(address(this));
        uint256 received = afterBalance >= beforeBalance ? afterBalance - beforeBalance : 0;
        if (received != amount) revert UnexpectedTokenAmount(amount, received);
    }

    function _interestSince(Position storage p, uint256 elapsed)
        private
        view
        returns (uint256 interest, uint256 remainder)
    {
        if (p.principal == 0) return (0, 0);
        uint256 factor = interestRatePerSecond * elapsed;
        interest = Math.mulDiv(p.principal, factor, RATE_SCALE);
        uint256 fraction = mulmod(p.principal, factor, RATE_SCALE) + p.interestRemainder;
        interest += fraction / RATE_SCALE;
        remainder = fraction % RATE_SCALE;
    }

    function _accrue() private {
        uint256 elapsed = block.timestamp - lastAccrual;
        if (elapsed == 0) return;
        uint256 accrued;
        for (uint256 i; i < _borrowers.length; ++i) {
            Position storage p = _positions[_borrowers[i]];
            (uint256 interest, uint256 remainder) = _interestSince(p, elapsed);
            p.interest += interest;
            p.interestRemainder = remainder;
            accrued += interest;
        }
        lastAccrual = block.timestamp;
        totalAccruedInterest += accrued;
        if (accrued != 0) emit InterestAccrued(accrued, block.timestamp);
    }

    function _reduceDebt(Position storage p, uint256 amount)
        private
        returns (uint256 interestPaid, uint256 principalPaid)
    {
        interestPaid = Math.min(amount, p.interest);
        principalPaid = amount - interestPaid;
        p.interest -= interestPaid;
        p.principal -= principalPaid;
        totalAccruedInterest -= interestPaid;
        totalPrincipal -= principalPaid;
        if (p.principal == 0 && p.interest == 0) p.interestRemainder = 0;
    }

    function _receiveNFT(IERC721 token, address from, uint256 id) private {
        _receivingAsset = address(token);
        _receivingFrom = from;
        token.safeTransferFrom(from, address(this), id);
        _receivingAsset = address(0);
        _receivingFrom = address(0);
        if (token.ownerOf(id) != address(this)) revert UnexpectedNFT();
    }

    function _stakeOne(uint256 id) private returns (uint256 power, uint256 level) {
        (uint256 beforePower,) = staking.accountPower(address(this));
        uint256[] memory ids = new uint256[](1);
        ids[0] = id;
        squeek.approve(address(staking), id);
        staking.deposit(address(squeek), ids);
        (uint256 afterPower,) = staking.accountPower(address(this));
        if (afterPower <= beforePower) revert InvalidPower(0);
        uint256 delta = afterPower - beforePower;
        if (delta % 1e18 != 0) revert InvalidPower(delta);
        power = delta / 1e18;
        // Published policy: power = 1000 * (2 ** level - 1), starting at level 1.
        uint256 scaled = power / 1000 + 1;
        if (power % 1000 != 0 || (scaled & (scaled - 1)) != 0) revert InvalidPower(power);
        level = Math.log2(scaled);
        if (squeek.ownerOf(id) != address(staking)) revert UnexpectedNFT();
    }

    function _removePosition(address borrower) private returns (uint256[] memory ids) {
        Position storage p = _positions[borrower];
        ids = p.tokenIds;
        totalEscrowedPower -= p.power;
        uint256 index = _positionIndex[borrower] - 1;
        address last = _borrowers[_borrowers.length - 1];
        _borrowers[index] = last;
        _positionIndex[last] = index + 1;
        _borrowers.pop();
        delete _positionIndex[borrower];
        delete _positions[borrower];
    }

    function _returnCollateral(uint256[] memory ids, address recipient) private {
        _receivingAsset = address(squeek);
        _receivingFrom = address(staking);
        staking.withdraw(address(squeek), ids);
        _receivingAsset = address(0);
        _receivingFrom = address(0);
        for (uint256 i; i < ids.length; ++i) {
            squeek.safeTransferFrom(address(this), recipient, ids[i]);
        }
    }

    function _valueFromLine(uint256 line) private view returns (uint256) {
        uint256 ltv = valuer.ltvBps();
        if (ltv == 0 || ltv > 6000) revert InvalidParameter();
        return Math.mulDiv(line, BPS, ltv);
    }

    function _vested(BondSchedule storage b) private view returns (uint256) {
        uint256 elapsed = block.timestamp - b.start;
        return elapsed >= b.duration ? b.shares : Math.mulDiv(b.shares, elapsed, b.duration);
    }
}

// Adapted from Uniswap v4-core TickMath.sol (MIT, copyright Uniswap Labs).
// Only the forward tick calculation is included; custom reverts use Solidity.
// https://github.com/Uniswap/v4-core/blob/main/src/libraries/TickMath.sol
library BurrowTickMath {
    error InvalidTick(int24 tick);
    int24 internal constant MAX_TICK = 887272;
    uint160 internal constant MIN_SQRT_PRICE = 4295128739;
    uint160 internal constant MAX_SQRT_PRICE = 1461446703485210103287273052203988822378723970342;

    function sqrtPriceAtTick(int24 tick) internal pure returns (uint160 sqrtPriceX96) {
        unchecked {
            uint256 absTick;
            assembly ("memory-safe") {
                tick := signextend(2, tick)
                // mask = 0 if tick >= 0 else -1 (all 1s)
                let mask := sar(255, tick)
                // if tick >= 0, |tick| = tick = 0 ^ tick
                // if tick < 0, |tick| = ~~|tick| = ~(-|tick| - 1) = ~(tick - 1) = (-1) ^ (tick - 1)
                // either way, |tick| = mask ^ (tick + mask)
                absTick := xor(mask, add(mask, tick))
            }

            if (absTick > uint256(int256(MAX_TICK))) revert InvalidTick(tick);

            // The tick is decomposed into bits, and for each bit with index i that is set, the product of 1/sqrt(1.0001^(2^i))
            // is calculated (using Q128.128). The constants used for this calculation are rounded to the nearest integer

            // Equivalent to:
            //     price = absTick & 0x1 != 0 ? 0xfffcb933bd6fad37aa2d162d1a594001 : 0x100000000000000000000000000000000;
            //     or price = int(2**128 / sqrt(1.0001)) if (absTick & 0x1) else 1 << 128
            uint256 price;
            assembly ("memory-safe") {
                price := xor(shl(128, 1), mul(xor(shl(128, 1), 0xfffcb933bd6fad37aa2d162d1a594001), and(absTick, 0x1)))
            }
            if (absTick & 0x2 != 0) price = (price * 0xfff97272373d413259a46990580e213a) >> 128;
            if (absTick & 0x4 != 0) price = (price * 0xfff2e50f5f656932ef12357cf3c7fdcc) >> 128;
            if (absTick & 0x8 != 0) price = (price * 0xffe5caca7e10e4e61c3624eaa0941cd0) >> 128;
            if (absTick & 0x10 != 0) price = (price * 0xffcb9843d60f6159c9db58835c926644) >> 128;
            if (absTick & 0x20 != 0) price = (price * 0xff973b41fa98c081472e6896dfb254c0) >> 128;
            if (absTick & 0x40 != 0) price = (price * 0xff2ea16466c96a3843ec78b326b52861) >> 128;
            if (absTick & 0x80 != 0) price = (price * 0xfe5dee046a99a2a811c461f1969c3053) >> 128;
            if (absTick & 0x100 != 0) price = (price * 0xfcbe86c7900a88aedcffc83b479aa3a4) >> 128;
            if (absTick & 0x200 != 0) price = (price * 0xf987a7253ac413176f2b074cf7815e54) >> 128;
            if (absTick & 0x400 != 0) price = (price * 0xf3392b0822b70005940c7a398e4b70f3) >> 128;
            if (absTick & 0x800 != 0) price = (price * 0xe7159475a2c29b7443b29c7fa6e889d9) >> 128;
            if (absTick & 0x1000 != 0) price = (price * 0xd097f3bdfd2022b8845ad8f792aa5825) >> 128;
            if (absTick & 0x2000 != 0) price = (price * 0xa9f746462d870fdf8a65dc1f90e061e5) >> 128;
            if (absTick & 0x4000 != 0) price = (price * 0x70d869a156d2a1b890bb3df62baf32f7) >> 128;
            if (absTick & 0x8000 != 0) price = (price * 0x31be135f97d08fd981231505542fcfa6) >> 128;
            if (absTick & 0x10000 != 0) price = (price * 0x9aa508b5b7a84e1c677de54f3e99bc9) >> 128;
            if (absTick & 0x20000 != 0) price = (price * 0x5d6af8dedb81196699c329225ee604) >> 128;
            if (absTick & 0x40000 != 0) price = (price * 0x2216e584f5fa1ea926041bedfe98) >> 128;
            if (absTick & 0x80000 != 0) price = (price * 0x48a170391f7dc42444e8fa2) >> 128;

            assembly ("memory-safe") {
                // if (tick > 0) price = type(uint256).max / price;
                if sgt(tick, 0) { price := div(not(0), price) }

                // this divides by 1<<32 rounding up to go from a Q128.128 to a Q128.96.
                // we then downcast because we know the result always fits within 160 bits due to our tick input constraint
                // we round up in the division so getTickAtSqrtPrice of the output price is always consistent
                // `sub(shl(32, 1), 1)` is `type(uint32).max`
                // `price + type(uint32).max` will not overflow because `price` fits in 192 bits
                sqrtPriceX96 := shr(32, add(price, sub(shl(32, 1), 1)))
            }
        }
    }
}
