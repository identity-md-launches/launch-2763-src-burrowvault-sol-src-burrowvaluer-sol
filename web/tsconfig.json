{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true
  },
  "include": ["app.js", "config.js", "wallet.js", "wheel.js", "nft3d.js", "garage3d.js", "types.d.ts"],
  "exclude": ["assets", "tools"]
}
